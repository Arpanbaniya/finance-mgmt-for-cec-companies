# Generated local credentials: pnpm setup:local. Never use the local URLs in Vercel.
DATABASE_URL=
MIGRATION_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Public setup screen is available without these; sign-in needs all four.
# Local S3 credentials: pnpm setup:local. Cloud endpoints require HTTPS.
# Upload/scan/owner-bound download workflows are implemented separately.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
