# Generated local credentials: pnpm setup:local. Never use the local URLs in Vercel.
DATABASE_URL=
MIGRATION_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Sign-in needs DATABASE_URL and both BETTER_AUTH settings.
# Optional Supabase pooler role qualification; not a database credential.
SUPABASE_PROJECT_REF=
# Optional, server-only provider credential reserved for future features.
# No model calls are enabled by setting this value.
GROQ_API_KEY=
# Local S3 credentials: pnpm setup:local. Cloud endpoints require HTTPS.
# Upload/scan/owner-bound download workflows are implemented separately.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
