{
  "name": "kaamledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "services:up": "tsx scripts/local-postgres.ts",
    "storage:install": "tsx scripts/install-storage.ts",
    "storage:up": "tsx scripts/local-storage.ts",
    "test:storage": "vitest run --project storage",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "setup:local": "tsx scripts/setup-local.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "route-parity": "tsx scripts/route-parity.ts",
    "api:generate": "tsx scripts/generate-openapi.ts",
    "finance-reconcile": "vitest run --project unit tests/unit/accounting.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
